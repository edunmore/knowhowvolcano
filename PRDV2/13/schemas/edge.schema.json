{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticEdge",
  "type": "object",
  "properties": {
    "from_note_id": {
      "type": "string"
    },
    "to_note_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "to_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation_type": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "source_note_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "from_note_id",
    "relation_type",
    "rationale"
  ],
  "additionalProperties": true
}