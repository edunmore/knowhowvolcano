{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChunkGateResult",
  "type": "object",
  "properties": {
    "content_class": {
      "type": "string",
      "enum": [
        "core",
        "preface",
        "notes_for_reader",
        "toc",
        "marketing_blurb",
        "about_author",
        "legal",
        "references",
        "index",
        "appendix",
        "unknown"
      ]
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "SKIP",
        "LIGHT_SCAN",
        "FULL_MODEL"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "required": [
    "content_class",
    "relevance_score",
    "decision",
    "confidence",
    "reasons"
  ],
  "additionalProperties": false
}