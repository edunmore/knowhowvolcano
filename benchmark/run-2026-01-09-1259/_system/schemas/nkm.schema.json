{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedKnowledgeManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "target",
        "recovered"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonical_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "item_type": {
            "type": "string",
            "enum": [
              "concept",
              "procedure",
              "principle",
              "misconception",
              "definition",
              "example"
            ]
          },
          "title": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facets": {
            "type": "object",
            "additionalProperties": true
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          },
          "match_method": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "exact",
              "alias",
              "resolver",
              "none"
            ]
          },
          "match_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "item_type",
          "title",
          "aliases",
          "facets",
          "evidence"
        ],
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "relation": {
            "type": "string",
            "enum": [
              "prerequisite_of",
              "part_of",
              "contrasts_with",
              "causes",
              "supports"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source_id",
          "relation",
          "target_id"
        ]
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "topic_id",
    "source",
    "items",
    "relations",
    "meta"
  ],
  "additionalProperties": true
}