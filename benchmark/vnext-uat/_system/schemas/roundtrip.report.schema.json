{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoundTripReport",
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "vault_path": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverage_f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extras_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contradiction_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "manifest_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "precision",
        "recall",
        "coverage_f1",
        "extras_rate",
        "contradiction_rate",
        "manifest_alignment"
      ]
    },
    "diff": {
      "type": "object",
      "properties": {
        "missing_target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_recovered_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "scenario_id",
    "run_id",
    "vault_path",
    "metrics",
    "diff",
    "notes"
  ],
  "additionalProperties": true
}